# ========== 既存 ==========
GROQ_API_KEY=
NTFY_CHANNEL=line-reply-default
SUPABASE_URL=
SUPABASE_KEY=

# ========== LINE Messaging API ==========
# https://developers.line.biz/ で取得
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ========== Google Calendar API ==========
# Google Cloud Console > APIとサービス > 認証情報 > OAuth 2.0 クライアントID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# python3 setup/get_google_token.py を実行して取得
GOOGLE_REFRESH_TOKEN=
# 登録先カレンダーのID（メールアドレス形式）
CALENDAR_ID=nakashibakogyo@gmail.com

# ========== 管理ページ保護（必須）==========
# /save-token /contacts /latest /copy などの管理用エンドポイントを保護するトークン。
# 推測困難なランダム文字列を設定する（例: openssl rand -hex 24）。
# 未設定だとこれらのエンドポイントは常に 401（fail-closed）になる。
# 管理ページは URL に ?key=＜ADMIN_TOKEN＞ を付けて開く。
ADMIN_TOKEN=
